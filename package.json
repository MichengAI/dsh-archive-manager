    "@deepseek-ai/dsh-session-format-catalog": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-session-persistence": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-session-projection": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-session-projection-cache": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-spill": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-spill-local": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-storage": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-storage-domain": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-typert-protocol": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-typert-registry": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-workspace": "0.1.7-alpha.1",
    "@types/node": "^22.20.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.0.0",
    "esbuild": "0.25.0",
    "immer": "10.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "semver": "7.7.2",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "zustand": "4.4.7"
  },
  "license": "Apache-2.0",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-typert-registry",
        "@deepseek-ai/dsh-client-connection"
      ],
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MichengAI/dsh-archive-manager.git"
