    "@deepseek-ai/dsh-session-projection-cache": "0.1.0-rc.8 || 0.1.1-rc.2 || 0.1.2-rc.1 || 0.1.5-rc.1 || 0.1.5-rc.2 || 0.1.6-alpha.1 || 0.1.6-alpha.2 || 0.1.7-alpha.1",
    "@deepseek-ai/dsh-spill-local": "0.1.0-rc.8 || 0.1.1-rc.2 || 0.1.2-rc.1 || 0.1.5-rc.1 || 0.1.5-rc.2 || 0.1.6-alpha.1 || 0.1.6-alpha.2 || 0.1.7-alpha.1",
    "@deepseek-ai/dsh-storage-domain": "0.1.0-rc.8 || 0.1.1-rc.2 || 0.1.2-rc.1 || 0.1.5-rc.1 || 0.1.5-rc.2 || 0.1.6-alpha.1 || 0.1.6-alpha.2 || 0.1.7-alpha.1",
    "@deepseek-ai/dsh-typert-protocol": "0.1.0-rc.8 || 0.1.1-rc.2 || 0.1.2-rc.1 || 0.1.5-rc.1 || 0.1.5-rc.2 || 0.1.6-alpha.1 || 0.1.6-alpha.2 || 0.1.7-alpha.1",
    "@deepseek-ai/dsh-typert-registry": "0.1.0-rc.8 || 0.1.1-rc.2 || 0.1.2-rc.1 || 0.1.5-rc.1 || 0.1.5-rc.2 || 0.1.6-alpha.1 || 0.1.6-alpha.2 || 0.1.7-alpha.1",
    "@deepseek-ai/dsh-workspace": "0.1.0-rc.8 || 0.1.1-rc.2 || 0.1.2-rc.1 || 0.1.5-rc.1 || 0.1.5-rc.2 || 0.1.6-alpha.1 || 0.1.6-alpha.2 || 0.1.7-alpha.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-runtime": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-format-catalog": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-store": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.3",
    "@deepseek-ai/dsh-api-gateway": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-connection": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-locale": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-store": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-workspace": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-host-webserver": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-invariants": "0.1.7-alpha.1",
